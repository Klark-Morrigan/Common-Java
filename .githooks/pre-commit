#!/usr/bin/env bash
#
# Auto-fixes what this repo's commits need fixing: the executable bit on staged
# files that must carry it, and trailing whitespace in staged Markdown and Gradle
# scripts.
#
# Which fixes a commit gets, and the order they run in, live in
# Common-Automation's .github/lib/fixes/run-pre-commit-fixes.sh (sibling checkout),
# shared so every repo in the family fixes a commit the same way. What stays
# here is only what this repo alone knows: which tier it belongs to.
#
# Activated by running scripts/setup-hooks.sh once after cloning.

set -euo pipefail

hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "${hook_dir}/.." && pwd)"

readonly SHARED_FIXES_PATH='.github/lib/fixes/run-pre-commit-fixes.sh'

# Found the way scripts/ finds it, so COMMON_AUTOMATION_ROOT works here too.
# A missing copy stops the commit: a skip lets a commit through without its
# fixes, and nobody reads a hook's output when the commit succeeds.
# shellcheck source=scripts/imports/_require-common-automation-file.sh
source "${repo_root}/scripts/imports/_require-common-automation-file.sh"
require_common_automation_file "${SHARED_FIXES_PATH}"

# shellcheck source=/dev/null
source "${common_automation_root}/${SHARED_FIXES_PATH}"

# This tier's own declarations, which this repo owns and every JVM repo reads:
# the paths that must carry +x, and .gradle as a text type to trim.
run_pre_commit_fixes \
    "${repo_root}/.github/lib/executable-paths.sh" \
    "${repo_root}/.github/lib/trimmed-file-types.sh"
