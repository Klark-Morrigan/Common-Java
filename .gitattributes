# Pin line endings regardless of the operator's core.autocrlf setting.
# The bash scripts and workflow YAML here run on Linux CI runners, where a
# stray CR on a shebang line fails with
#   env: 'bash\r': No such file or directory
# exit 127 - which `git checkout` on a Windows workstation with autocrlf=true
# introduces silently. text=auto + eol=lf makes git normalise text files to LF
# in the working tree no matter what the operator's global git config says.
* text=auto eol=lf

# Batch files are the only Windows-side executables in the repo;
# cmd.exe requires CRLF, so pin them explicitly.
*.bat text eol=crlf
